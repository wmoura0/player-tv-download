<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite conexões HTTP e HTTPS necessárias para reprodução de transmissões de IPTV/Xtream -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
